{
  "name": "pimcore/payment-provider-hobex",
  "license": "GPL-3.0+",
  "type": "pimcore-bundle",
  "description": "Pimcore Payment Provider - Hobex",
  "config": {
    "sort-packages": true
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "pimcore/pimcore": "^2026.1",
    "pimcore/ecommerce-framework-bundle": "^2026.1",
    "pimcore/studio-backend-bundle": "^1.0 || ^2026.1",
    "pimcore/studio-ui-bundle": "^1.0 || ^2026.1"
  },
  "require-dev": {
    "phpstan/phpstan": "2.1.40"
  },
  "autoload": {
    "psr-4": {
      "Pimcore\\Bundle\\EcommerceFrameworkBundle\\": "src/",
      "Pimcore\\Model\\DataObject\\": "var/classes/DataObject"
    }
  },
  "extra": {
    "pimcore": {
      "bundles": [
        "Pimcore\\Bundle\\EcommerceFrameworkBundle\\PimcorePaymentProviderHobexBundle"
      ]
    }
  }
}
